; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ActionRPG"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://src/core/settings.gd"
Characters="*res://src/core/characters.gd"
GameData="*res://src/core/game_data.gd"
EventBus="*res://src/core/event_bus.gd"
Net="*res://src/net/network_manager.gd"
Sound="*res://src/core/sound_manager.gd"
SessionLog="*res://src/core/session_log.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

